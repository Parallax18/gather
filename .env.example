# API server port. The Vite dev server proxies /api to this port.
PORT=8787

# Set to false to start with an empty events list. The demo organizer account
# is still created so you can sign in and create events.
SEED=true

# Optional: store the SQLite file somewhere else.
# DB_PATH=./data/gather.db

# Set to true when serving over HTTPS so the session cookie is marked secure.
# COOKIE_SECURE=false
